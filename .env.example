# Copy to .env.local for local development.
# On Vercel, add the same variable under Project -> Settings -> Environment Variables.

# Public URL of your site, no trailing slash. Used for SEO metadata,
# the sitemap and social-share (Open Graph) links.
# If unset, Vercel's own URL is used automatically, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
